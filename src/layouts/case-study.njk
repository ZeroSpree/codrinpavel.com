---
layout: base.njk
---

{% set previousPost = collections.work | order | getPreviousCollectionItem %}
{% set nextPost = collections.work | order | getNextCollectionItem %}

<section class="study">
  <div class="wrapper">
    {% include "case-study.njk" %}

    <div class="columns md:--column-gap-2xl md:--row-gap-2xl">
      {{ content | safe }}
    </div>

    <footer class="pagination">
      <div class="columns columns-6 md:columns-5 justify-end --row-gap-zero">
        {% for item in collections.work | order %}
          <a href="{{ item.url | url }}" data-reveal data-stagger="150" {% if page.url == item.url %} aria-current="page"{% endif %}>
            <div>{{ loop.index < 10 and '0' + loop.index or loop.index }}.</div>
            <h2 class="mb-zero" data-title="{{item.data.type}}">{{item.data.long or item.data.title}}</h2>
          </a>
        {% endfor %}
      </div>
    </footer>
  </div>
</section>